# Copy to .env and adjust. Every value is optional; the defaults work for a local try-out.

# Change this before you put Freehold on a network.
POSTGRES_PASSWORD=freehold

# If you have MODIFIED Freehold, point this at your own repository. AGPL section 13 requires a
# modified network-served version to offer its source to the people using it, and this is the URL
# the app shows them. Running Freehold unmodified requires nothing of you; leave it empty.
SOURCE_URL=

# Port on your machine, and the address people use to reach Freehold (used in email links).
FREEHOLD_PORT=8080

# Which interface to publish on. Leave as is on a laptop. On a public server set this to
# 127.0.0.1 and put a TLS-terminating proxy in front, or the app is reachable over plain HTTP.
FREEHOLD_BIND=0.0.0.0
BASE_URL=http://localhost:8080

# Leave empty to generate one and keep it in the data volume. Changing it signs everyone out.
SECRET_KEY=

# false: only site admins create accounts. true: anyone who can reach the page can sign up.
ALLOW_SIGNUP=false

MAX_UPLOAD_MB=25

# Email notifications. Without SMTP_HOST, emails are written to the app log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Freehold <freehold@example.com>
SMTP_TLS=true
